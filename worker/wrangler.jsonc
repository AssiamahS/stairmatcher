{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stairmatch",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "ROOMS", "class_name": "ClimbRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby", "ClimbRoom"] }]
}
